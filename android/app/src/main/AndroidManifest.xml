<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- «Acceso a datos de uso»: lo da el usuario en Ajustes. Desde Android 14, algunas pantallas
         de Ajustes se ocultan al servicio de accesibilidad; con esto el modo estricto sabe igual
         qué app está en primer plano. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Solo en Android 8-11, para arrancar el filtro de sitios al encender el teléfono. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Tipo de servicio en primer plano que corresponde a una app de VPN (lo pide Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Para listar las apps instaladas que tienen ícono en el menú (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Para saber qué paquetes abren las pantallas de Ajustes en cada fabricante (modo estricto). -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.VPN_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".BloqueadorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bloqueador">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla que aparece encima de una app bloqueada. Va en su propia tarea. -->
        <activity
            android:name=".bloqueo.PantallaBloqueoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.bloqueador.android.bloqueo" />

        <!-- Detecta qué app se abre para cerrar las bloqueadas. -->
        <service
            android:name=".bloqueo.ServicioAccesibilidad"
            android:exported="true"
            android:label="@string/servicio_accesibilidad"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>

        <!-- VPN local que solo filtra las consultas DNS de los sitios bloqueados. Solo pasa a
             primer plano un instante al arrancar en Android 8-11. Lint pide además un permiso de
             alarmas exactas para systemExempted, pero a una app de VPN Android no se lo exige. -->
        <service
            android:name=".bloqueo.FiltroVpnService"
            android:exported="true"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <receiver
            android:name=".bloqueo.ReceptorArranque"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Protección contra desinstalación (opcional): administrador de dispositivo sin
             políticas. Mientras está activo, Android no deja desinstalar el Bloqueador. -->
        <receiver
            android:name=".bloqueo.AdminDispositivo"
            android:description="@string/descripcion_admin_dispositivo"
            android:exported="true"
            android:label="@string/admin_dispositivo"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/admin_dispositivo" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
